{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paperseal",
  "version": "0.4.0",
  "identifier": "studio.paperseal.desktop",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "纸印 · PDF 盖章", "width": 1160, "height": 790, "minWidth": 760, "minHeight": 520 }],
    "security": { "capabilities": [{"identifier":"main-window","windows":["main"],"permissions":["core:event:allow-listen","core:event:allow-unlisten","core:window:allow-destroy"]}], "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost blob: data:" }
  },
  "bundle": {
    "active": true, "targets": ["deb", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "离线 PDF 盖章、签字图片和骑缝章",
    "linux": { "deb": { "section": "office" } }
  }
}
